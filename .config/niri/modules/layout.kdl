layout {
    gaps 5

    border {
        width 2
        active-color   "#24bd5c"
        inactive-color "#24bd5c73"
    }

    focus-ring {
        width 2
        active-color   "#24bd5c"
        inactive-color "#24bd5c73"
    }
}

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}
